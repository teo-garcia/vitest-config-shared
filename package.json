{
  "author": "teo-garcia",
  "exports": {
    ".": {
      "default": "./react.js",
      "types": "./react.d.ts"
    },
    "./next": {
      "default": "./next.js",
      "types": "./next.d.ts"
    },
    "./angular": {
      "default": "./angular.js",
      "types": "./angular.d.ts"
    }
  },
  "files": [
    "*.d.ts",
    "*.js"
  ],
  "main": "./react.js",
  "name": "@teo-garcia/vitest-config-shared",
  "peerDependencies": {
    "@vitejs/plugin-react": "^5.0.4 || ^6.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "jsdom": "^26.0.0 || ^27.0.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-react": {
      "optional": true
    },
    "@vitest/browser-playwright": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teo-garcia/vitest-config-shared.git"
  },
  "type": "module",
  "types": "./react.d.ts",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "prettier": "@teo-garcia/prettier-config-shared",
  "version": "0.4.1",
  "scripts": {
    "check": "pnpm format:check && pnpm audit --audit-level=high && pnpm smoke:consumer",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@teo-garcia/prettier-config-shared": "^0.2.9",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.1",
    "vitest": "^4.0.0"
  }
}
